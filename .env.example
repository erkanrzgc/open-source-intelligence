# open-source-intelligence — sample environment file
# Export only the keys you need through your process manager or container.
# Modules silently skip optional integrations when their key is missing.

# ── Runtime ───────────────────────────────────────────────────────────────
# OSINT_MAX_CONCURRENT=50
# OSINT_PER_HOST_CONCURRENCY=6
# OSINT_TIMEOUT=15
# OSINT_RETRIES=2
# OSINT_RETRY_DELAY=1.0
# OSINT_RATE_LIMIT_DELAY=0.1
# OSINT_INSECURE_TLS=0
# OSINT_LOG_LEVEL=WARNING
# OSINT_PLATFORMS_FILE=/path/to/platforms.yaml
# OSINT_SCAN_JOB_MAX_JOBS=100
# OSINT_SCAN_JOB_CONCURRENCY=2
# OSINT_SCAN_JOB_MAX_EVENTS=500

# ── LLM (NVIDIA NIM by default) ──────────────────────────────────────────
# Free tier: ~1000 req/month. https://build.nvidia.com
OSINT_LLM_BACKEND=http
OSINT_LLM_URL=https://integrate.api.nvidia.com/v1/chat/completions
OSINT_LLM_API_KEY=nvapi-REPLACE_ME
OSINT_LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# OSINT_LLM_REVISION=0b58da4736f799f3cb5bbaffb8a39025f1c4e5df
# OSINT_LLM_ALLOW_PRIVATE_NETWORKS=0  # set for an explicit local Ollama/vLLM URL
OSINT_LLM_MAX_TOKENS=1024
OSINT_LLM_TEMPERATURE=0.2
OSINT_LLM_TIMEOUT=120
# Default is NVIDIA's Nemotron tune of Llama-3.1-70b — same speed/cost as
# stock Llama-3.3, better JSON adherence, lower refusal rate on legitimate
# red-team prompts. Other NIM models worth trying:
#   meta/llama-3.3-70b-instruct          — newer cutoff, stricter alignment
#   deepseek-ai/deepseek-r1              — chain-of-thought, slower
#   meta/llama-3.1-8b-instruct           — fast/cheap for bulk pretext
#   meta/llama-3.1-405b-instruct         — flagship, slow + costly
# To use OpenAI / Groq / Ollama instead, override URL + KEY + MODEL.

# ── OSINT module API keys ────────────────────────────────────────────────
# HIBP — paid breach lookup ($3.95/mo). https://haveibeenpwned.com/API/Key
# HIBP_API_KEY=
# NumVerify — phone enrichment, free 250/mo. https://numverify.com
# NUMVERIFY_API_KEY=
# GitHub — recommended (60→5000 req/hr). https://github.com/settings/tokens
# GITHUB_TOKEN=
# Exact profile providers (all credential-gated providers fail closed when unset):
# OSINT_FOREM_API_KEY=             # optional Forem/DEV API key
# OSINT_REDDIT_BEARER_TOKEN=       # optional pre-minted OAuth access token
# OSINT_REDDIT_CLIENT_ID=          # preferred: mint a fresh app token per scan
# OSINT_REDDIT_CLIENT_SECRET=      # secret for client_credentials
# OSINT_REDDIT_USER_AGENT=         # honest unique UA required by Reddit
# OSINT_X_BEARER_TOKEN=            # X API v2 bearer token
# OSINT_YOUTUBE_API_KEY=           # YouTube Data API v3 key
# OSINT_TWITCH_CLIENT_ID=          # Twitch application client id
# OSINT_TWITCH_CLIENT_SECRET=      # preferred: mint a fresh app token per scan
# OSINT_TWITCH_ACCESS_TOKEN=       # optional pre-minted app/user access token
# OSINT_STEAM_API_KEY=             # Steam Web API key

# Passive recon (host/cert/leak indexes — all skip when missing):
# SHODAN_API_KEY=
# CENSYS_API_ID=
# CENSYS_API_SECRET=
# ZOOMEYE_API_KEY=
# FOFA_EMAIL=
# FOFA_KEY=
# CRIMINALIP_API_KEY=
# SERPAPI_API_KEY=                  # google_dork uses DDG fallback when unset
# WIGLE_API_NAME=                   # both halves required for BSSID lookup
# WIGLE_API_TOKEN=
# OPENCORPORATES_API_TOKEN=         # optional; lifts free-tier rate limit
# INTELX_API_KEY=                   # required for paste/leak/dark-web index

# Other:
# ETHERSCAN_API_KEY=                # ETH balance and transaction enrichment
# TINEYE_API_KEY=                   # Yandex fallback runs without a key
# IG_SESSION_ID=                    # Toutatis rich Instagram mode
# OSINT_AUTH_REQUIRED=0             # enable bearer-token enforcement
# OSINT_AUTH_SECRET=                # required when authentication is enabled
# OSINT_TELEGRAM_BOT_TOKEN=
# OSINT_TELEGRAM_CHAT_ID=
# OSINT_WEBHOOK_URL=
# OSINT_WEBHOOK_SECRET=
# OSINT_WEBHOOK_ALLOW_PRIVATE_NETWORKS=0  # set only for an explicit local receiver
# GOPHISH_API_KEY=
